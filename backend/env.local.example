# Local development env template.
# cp backend/env.local.example backend/.env  (or project root .env)

API_PORT=8000
API_ROOT=
API_LOG_PATH=./logs
API_LOG_LEVEL=INFO
SSE_QUEUE_MAX_SIZE=100
PING_INTERVAL=10
DOCUMENT_WORKSPACE_MAX_AGE_SECONDS=86400

# Dynaconf
ENV_FOR_DYNACONF=default
ENVVAR_PREFIX_FOR_DYNACONF=false
VAULT_ENABLED_FOR_DYNACONF=false
SETTINGS_FILES_FOR_DYNACONF='["src/common/config/toml/*.toml"]'
PYTHONPATH=.

# Router AI (required for LLM graph)
ROUTER_AI_API_KEY=
ROUTER_AI_BASE_URL=https://routerai.ru/api/v1

# Optional / legacy LLM keys
GIGACHAT_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# S3 anonymized documents (required for file chat)
S3_SERVICE_BASE_URL=https://s3-service.dv.gigalegal.tech/
S3_SERVICE_ACCESS_TOKEN=
S3_SERVICE_TIMEOUT_SECONDS=300

# Prompts — defaults to src/agents/prompts if unset
PROMPTS_DIR=src/agents/prompts

# Langfuse (optional; leave empty to disable)
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=False
LANGFUSE_TIMEOUT=30
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_USER_ID=

PROJECT_NAME=chat-with-documents
PROJECT_TAG=local
